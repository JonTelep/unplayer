# Copy to .env (`cp .env.example .env`) and edit. `make deploy` and `make local` read it.
# .env is gitignored, so your password never ends up in git.

# Public hostname for HTTPS (make deploy). Point its DNS A record at your server.
# Not used by `make local`, but leave something here.
DOMAIN=streams.example.com

# Optional phrase that locks the site. Visitors type it once per browser (remembered a year).
# Empty = open to anyone, so set one on a public server. Generate one: openssl rand -base64 24
# Changing it logs everyone out.
PASSWORD=

# Max streams relayed at once (each is one ffmpeg process plus its bandwidth).
MAX_STREAMS=5
